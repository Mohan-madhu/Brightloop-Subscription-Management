# Copy relevant values to apps/api/.env (the API loads only that file).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/brightloop?schema=public"
PORT=4000
WEB_ORIGIN="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TIMEOUT_MS=20000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
JOBS_ENABLED=false
EMAIL_DELIVERY_ENABLED=false
BILLING_JOB_INTERVAL_MS=900000
EMAIL_JOB_INTERVAL_MS=60000
QUARTERLY_JOB_INTERVAL_MS=86400000
REPORT_RECIPIENTS=

# Copy to apps/web/.env.local. This value is safe to expose to the browser.
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api/v1"
