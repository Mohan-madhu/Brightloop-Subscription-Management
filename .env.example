# ===================================================
# BRIGHTLOOP SUBSCRIPTION MANAGEMENT SYSTEM - ENVIRONMENT TEMPLATE
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
PUBLIC_URL=http://localhost:3000
API_URL=http://localhost:5000/api/v1

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_NAME="Brightloop Subscription Management"
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_brightloop_placeholder

# Database Configuration (PostgreSQL / SQLite for local development)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brightloop_db?schema=public"

# Authentication & Security
JWT_SECRET=brightloop_super_secret_jwt_key_at_least_32_chars_long
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=brightloop_super_secret_refresh_token_key_32_chars
REFRESH_TOKEN_EXPIRES_IN=30d
COOKIE_SECRET=brightloop_secure_cookie_signing_secret_phrase

# Razorpay Integration (Test Mode)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_brightloop

# Gmail SMTP Email Notification Integration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=brightloop.notifications@gmail.com
SMTP_PASS=your_gmail_app_password_here
EMAIL_FROM="Brightloop Billing <no-reply@brightloop.local>"

# Automated Billing & Email Jobs (Disabled by default in local dev)
ENABLE_AUTOMATED_BILLING_JOB=false
ENABLE_AUTOMATED_EMAIL_JOB=false
BILLING_CRON_SCHEDULE="0 0 * * *"
QUARTERLY_REPORT_CRON_SCHEDULE="0 0 1 1,4,7,10 *"
