{
  "name": "brightloop-subscription-management",
  "version": "1.0.0",
  "private": true,
  "description": "Brightloop Subscription Management System - Monorepo",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "start": "npm run start --workspaces",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace=apps/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=apps/api",
    "prisma:seed": "npm run prisma:seed --workspace=apps/api"
  },
  "keywords": [
    "subscription-management",
    "brightloop",
    "nextjs",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "Brightloop Team",
  "license": "UNLICENSED"
}
