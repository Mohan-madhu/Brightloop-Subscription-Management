generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum UserKind {
  STAFF
  CUSTOMER
}
enum TokenPurpose {
  ACTIVATION
  PASSWORD_RESET
}
enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}
enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}
enum InvoiceStatus {
  DRAFT
  CONFIRMED
  SENT
  PARTIALLY_PAID
  PAID
  CANCELLED
  OVERDUE
}
enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  VOID
}
enum DiscountKind {
  FIXED
  PERCENTAGE
}
enum ReportStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id String @id @default(cuid())
 email String @unique
 kind UserKind
 isActive Boolean @default(false)
  firstName String
 lastName String?
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
  credential AuthCredential?
 roles UserRole[]
 customer Customer?
 assignments CustomerAssignment[] @relation("assignee")
 tokens AuthToken[]
}
model AuthCredential {
id String @id @default(cuid())
 userId String @unique
 passwordHash String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 user User @relation(fields:[userId],references:[id],onDelete:Restrict)
}
model Role {
id String @id @default(cuid())
 code String @unique
 name String
 createdAt DateTime @default(now())
 userRoles UserRole[]
}
model UserRole {
userId String
 roleId String
 createdAt DateTime @default(now())
 user User @relation(fields:[userId],references:[id],onDelete:Restrict)
 role Role @relation(fields:[roleId],references:[id],onDelete:Restrict)
 @@id([userId,roleId])
 @@index([roleId])
}
model AuthToken {
id String @id @default(cuid())
 userId String
 purpose TokenPurpose
 tokenHash String @unique
 expiresAt DateTime
 usedAt DateTime?
 createdAt DateTime @default(now())
 user User @relation(fields:[userId],references:[id],onDelete:Restrict)
 @@index([userId,purpose,expiresAt])
}
model Customer {
id String @id @default(cuid())
 userId String @unique
 legalName String
 billingEmail String
 billingAddress Json?
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 user User @relation(fields:[userId],references:[id],onDelete:Restrict)
 assignments CustomerAssignment[]
 quotations Quotation[]
 subscriptions Subscription[]
 invoices Invoice[]
}
model CustomerAssignment {
customerId String
 userId String
 createdAt DateTime @default(now())
 customer Customer @relation(fields:[customerId],references:[id],onDelete:Restrict)
 user User @relation("assignee",fields:[userId],references:[id],onDelete:Restrict)
 @@id([customerId,userId])
 @@index([userId])
}
model Attribute {
id String @id @default(cuid())
 name String @unique
 values VariantAttributeValue[]
 createdAt DateTime @default(now())
}
model Product {
id String @id @default(cuid())
 name String @unique
 type String
 salesPrice Decimal @db.Decimal(14,2)
 costPrice Decimal @db.Decimal(14,2)
 notes String?
 active Boolean @default(true)
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 variants ProductVariant[]
 planProducts PlanProduct[]
 taxApplicability TaxApplicability[]
 discountTargets DiscountTarget[]
 templateLines TemplateLine[]
 quoteLines QuotationLine[]
 subscriptionLines SubscriptionLine[]
}
model ProductVariant {
id String @id @default(cuid())
 productId String
 sku String? @unique
 priceAdjustment Decimal @default(0) @db.Decimal(14,2)
 active Boolean @default(true)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 product Product @relation(fields:[productId],references:[id],onDelete:Restrict)
 attributes VariantAttributeValue[]
 planProducts PlanProduct[]
 discountTargets DiscountTarget[]
 @@index([productId])
}
model VariantAttributeValue {
variantId String
 attributeId String
 value String
 variant ProductVariant @relation(fields:[variantId],references:[id],onDelete:Restrict)
 attribute Attribute @relation(fields:[attributeId],references:[id],onDelete:Restrict)
 @@id([variantId,attributeId])
 @@index([attributeId])
}
model BillingInterval {
id String @id @default(cuid())
 code String @unique
 name String
 unit String
 count Int @default(1)
 active Boolean @default(true)
 createdAt DateTime @default(now())
 plans Plan[]
}
model Plan {
id String @id @default(cuid())
 name String @unique
 billingIntervalId String
 price Decimal @db.Decimal(14,2)
 minimumQuantity Int @default(1)
 availableFrom DateTime? @db.Date
 availableUntil DateTime? @db.Date
 allowEarlyClosure Boolean @default(false)
 allowPause Boolean @default(false)
 allowRenewal Boolean @default(true)
 allowEndDateClosure Boolean @default(true)
 active Boolean @default(true)
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 billingInterval BillingInterval @relation(fields:[billingIntervalId],references:[id],onDelete:Restrict)
 products PlanProduct[]
 subscriptions Subscription[]
 discountTargets DiscountTarget[]
 taxApplicability TaxApplicability[]
 @@index([billingIntervalId,active])
}
model PlanProduct {
planId String
 productId String
 variantId String?
 isAddon Boolean @default(false)
 price Decimal @db.Decimal(14,2)
 plan Plan @relation(fields:[planId],references:[id],onDelete:Restrict)
 product Product @relation(fields:[productId],references:[id],onDelete:Restrict)
 variant ProductVariant? @relation(fields:[variantId],references:[id],onDelete:Restrict)
 @@id([planId,productId,isAddon])
 @@index([productId])
 @@index([variantId])
}
model Tax {
id String @id @default(cuid())
 name String
 rate Decimal @db.Decimal(5,2)
 taxExclusive Boolean @default(true)
 active Boolean @default(true)
 createdAt DateTime @default(now())
 applicability TaxApplicability[]
}
model TaxApplicability {
id String @id @default(cuid())
 taxId String
 productId String?
 planId String?
 tax Tax @relation(fields:[taxId],references:[id],onDelete:Restrict)
 product Product? @relation(fields:[productId],references:[id],onDelete:Restrict)
 plan Plan? @relation(fields:[planId],references:[id],onDelete:Restrict)
 @@unique([taxId,productId,planId])
}
model Discount {
id String @id @default(cuid())
 code String @unique
 kind DiscountKind
 amount Decimal @db.Decimal(14,2)
 minimumPurchase Decimal? @db.Decimal(14,2)
 minimumQuantity Int?
 startsAt DateTime?
 endsAt DateTime?
 usageLimit Int?
 active Boolean @default(true)
 createdAt DateTime @default(now())
 targets DiscountTarget[]
 usages DiscountUsage[]
}
model DiscountTarget {
id String @id @default(cuid())
 discountId String
 productId String?
 variantId String?
 planId String?
 discount Discount @relation(fields:[discountId],references:[id],onDelete:Restrict)
 product Product? @relation(fields:[productId],references:[id],onDelete:Restrict)
 variant ProductVariant? @relation(fields:[variantId],references:[id],onDelete:Restrict)
 plan Plan? @relation(fields:[planId],references:[id],onDelete:Restrict)
 @@index([discountId])
}
model DiscountUsage {
id String @id @default(cuid())
 discountId String
 invoiceId String @unique
 reservedAt DateTime @default(now())
 consumedAt DateTime?
 releasedAt DateTime?
 discount Discount @relation(fields:[discountId],references:[id],onDelete:Restrict)
 invoice Invoice @relation(fields:[invoiceId],references:[id],onDelete:Restrict)
 @@index([discountId,consumedAt,releasedAt])
}
model QuotationTemplate {
id String @id @default(cuid())
 name String @unique
 validityDays Int
 terms String?
 active Boolean @default(true)
 createdAt DateTime @default(now())
 lines TemplateLine[]
}
model TemplateLine {
id String @id @default(cuid())
 templateId String
 productId String
 variantId String?
 quantity Int
 unitPrice Decimal @db.Decimal(14,2)
 template QuotationTemplate @relation(fields:[templateId],references:[id],onDelete:Restrict)
 product Product @relation(fields:[productId],references:[id],onDelete:Restrict)
 @@index([templateId])
}
model Quotation {
id String @id @default(cuid())
 number String @unique
 customerId String
 status QuoteStatus @default(DRAFT)
 validUntil DateTime? @db.Date
 terms String?
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 customer Customer @relation(fields:[customerId],references:[id],onDelete:Restrict)
 lines QuotationLine[]
 logs QuotationStatusLog[]
 subscription Subscription?
 @@index([customerId,status])
}
model QuotationLine {
id String @id @default(cuid())
 quotationId String
 productId String
 variantId String?
 description String
 quantity Int
 unitPrice Decimal @db.Decimal(14,2)
 quotation Quotation @relation(fields:[quotationId],references:[id],onDelete:Restrict)
 product Product @relation(fields:[productId],references:[id],onDelete:Restrict)
 @@index([quotationId])
}
model QuotationStatusLog {
id String @id @default(cuid())
 quotationId String
 status QuoteStatus
 note String?
 createdAt DateTime @default(now())
 quotation Quotation @relation(fields:[quotationId],references:[id],onDelete:Restrict)
 @@index([quotationId,createdAt])
}
model Subscription {
id String @id @default(cuid())
 number String @unique
 customerId String
 planId String
 quotationId String? @unique
 status SubscriptionStatus @default(DRAFT)
 startDate DateTime @db.Date
 expiryDate DateTime? @db.Date
 billingAnchorDay Int
 paymentTerms String?
 pausedEffectiveAt DateTime?
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 customer Customer @relation(fields:[customerId],references:[id],onDelete:Restrict)
 plan Plan @relation(fields:[planId],references:[id],onDelete:Restrict)
 quotation Quotation? @relation(fields:[quotationId],references:[id],onDelete:Restrict)
 lines SubscriptionLine[]
 logs SubscriptionStatusLog[]
 periods BillingPeriod[]
 @@index([customerId,status])
 @@index([planId,status])
}
model SubscriptionLine {
id String @id @default(cuid())
 subscriptionId String
 productId String
 variantId String?
 description String
 quantity Int
 agreedPrice Decimal @db.Decimal(14,2)
 isAddon Boolean @default(false)
 subscription Subscription @relation(fields:[subscriptionId],references:[id],onDelete:Restrict)
 product Product @relation(fields:[productId],references:[id],onDelete:Restrict)
 @@index([subscriptionId])
}
model SubscriptionStatusLog {
id String @id @default(cuid())
 subscriptionId String
 status SubscriptionStatus
 note String?
 effectiveAt DateTime?
 createdAt DateTime @default(now())
 subscription Subscription @relation(fields:[subscriptionId],references:[id],onDelete:Restrict)
 @@index([subscriptionId,createdAt])
}
model BillingPeriod {
id String @id @default(cuid())
 subscriptionId String
 startsAt DateTime @db.Date
 endsAt DateTime @db.Date
 dueAt DateTime @db.Date
 createdAt DateTime @default(now())
 subscription Subscription @relation(fields:[subscriptionId],references:[id],onDelete:Restrict)
 invoice Invoice?
 @@unique([subscriptionId,startsAt,endsAt])
 @@index([dueAt])
}
model Invoice {
id String @id @default(cuid())
 number String @unique
 customerId String
 billingPeriodId String @unique
 status InvoiceStatus @default(DRAFT)
 currency String @default("INR")
 dueDate DateTime @db.Date
 customerSnapshot Json
 subtotal Decimal @db.Decimal(14,2)
 discountTotal Decimal @default(0) @db.Decimal(14,2)
 taxTotal Decimal @default(0) @db.Decimal(14,2)
 total Decimal @db.Decimal(14,2)
 balance Decimal @db.Decimal(14,2)
 discountSnapshot Json?
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 customer Customer @relation(fields:[customerId],references:[id],onDelete:Restrict)
 billingPeriod BillingPeriod @relation(fields:[billingPeriodId],references:[id],onDelete:Restrict)
 lines InvoiceLine[]
 logs InvoiceStatusLog[]
 payments Payment[]
 discountUsage DiscountUsage?
 orders ProviderOrder[]
 @@index([customerId,status,dueDate])
 @@index([status,dueDate])
}
model InvoiceLine {
id String @id @default(cuid())
 invoiceId String
 description String
 quantity Int
 unitPrice Decimal @db.Decimal(14,2)
 discountAmount Decimal @default(0) @db.Decimal(14,2)
 lineTotal Decimal @db.Decimal(14,2)
 snapshot Json?
 invoice Invoice @relation(fields:[invoiceId],references:[id],onDelete:Restrict)
 taxes InvoiceLineTax[]
 @@index([invoiceId])
}
model InvoiceLineTax {
id String @id @default(cuid())
 invoiceLineId String
 name String
 rate Decimal @db.Decimal(5,2)
 amount Decimal @db.Decimal(14,2)
 invoiceLine InvoiceLine @relation(fields:[invoiceLineId],references:[id],onDelete:Restrict)
 @@index([invoiceLineId])
}
model InvoiceStatusLog {
id String @id @default(cuid())
 invoiceId String
 status InvoiceStatus
 note String?
 createdAt DateTime @default(now())
 invoice Invoice @relation(fields:[invoiceId],references:[id],onDelete:Restrict)
 @@index([invoiceId,createdAt])
}
model Payment {
id String @id @default(cuid())
 invoiceId String
 method String
 amount Decimal @db.Decimal(14,2)
 paidAt DateTime
 note String?
 providerPaymentId String? @unique
 status PaymentStatus @default(PENDING)
 createdAt DateTime @default(now())
 invoice Invoice @relation(fields:[invoiceId],references:[id],onDelete:Restrict)
 logs PaymentStatusLog[]
 @@index([invoiceId,status])
 @@index([providerPaymentId])
}
model PaymentStatusLog {
id String @id @default(cuid())
 paymentId String
 status PaymentStatus
 note String?
 createdAt DateTime @default(now())
 payment Payment @relation(fields:[paymentId],references:[id],onDelete:Restrict)
 @@index([paymentId,createdAt])
}
model ProviderOrder {
id String @id @default(cuid())
 invoiceId String
 provider String
 providerOrderId String @unique
 amount Decimal @db.Decimal(14,2)
 currency String
 createdAt DateTime @default(now())
 invoice Invoice @relation(fields:[invoiceId],references:[id],onDelete:Restrict)
 @@index([invoiceId])
}
model WebhookEvent {
id String @id @default(cuid())
 provider String
 providerEventId String @unique
 payload Json
 receivedAt DateTime @default(now())
 processedAt DateTime?
 @@index([provider,processedAt])
}
model CompanySetting {
id String @id @default(cuid())
 legalName String
 publicName String
 supportEmail String?
 address String?
 currency String @default("INR")
 timezone String @default("Asia/Kolkata")
 communication Json?
 updatedAt DateTime @updatedAt
}
model EmailOutbox {
id String @id @default(cuid())
 to String
 subject String
 body Json
 status String @default("PENDING")
 attempts Int @default(0)
 createdAt DateTime @default(now())
 sentAt DateTime?
 @@index([status,createdAt])
}
model MessageLog {
id String @id @default(cuid())
 outboxId String?
 channel String
 status String
 metadata Json?
 createdAt DateTime @default(now())
 @@index([outboxId])
}
model ReportRun {
id String @id @default(cuid())
 reportType String
 periodKey String
 status ReportStatus @default(QUEUED)
 startedAt DateTime?
 completedAt DateTime?
 metadata Json?
 createdAt DateTime @default(now())
 @@unique([reportType,periodKey])
 @@index([status,createdAt])
}
